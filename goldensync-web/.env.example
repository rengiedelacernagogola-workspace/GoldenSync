# Copy to .env.local and fill. Never commit real secrets.

# --- Clerk (use Production keys on Vercel Production) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Sign-up methods: configure in Clerk Dashboard → User & Authentication.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=

# --- Prisma / Neon ---
# Prefer UNPOOLED (direct) URL for Prisma Composer — pooler startup options are rejected.
# Set the same DATABASE_URL on Vercel Production + Preview.
DATABASE_URL="postgresql://USER:PASS@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Vercel Blob (private store) ---
# https://vercel.com/dashboard → Storage → Blob → token
BLOB_READ_WRITE_TOKEN=

# --- Cron (Vercel Cron → /api/cron/purge) ---
# Generate a long random string; Vercel injects Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Trigger.dev (optional; syllabus parse runs in Next.js, not Trigger) ---
# TRIGGER_SECRET_KEY=
# TRIGGER_PROJECT_REF=
